        <mxCell id="y6c3Vtqz6U0YL3FhFZXc-75" value="&lt;p data-start=&quot;40&quot; data-end=&quot;179&quot;&gt;An &lt;strong data-start=&quot;59&quot; data-end=&quot;85&quot;&gt;Availability Zone (AZ)&lt;/strong&gt; is a &lt;strong data-start=&quot;91&quot; data-end=&quot;126&quot;&gt;physically separate data center&lt;/strong&gt; within the same Azure region. Each zone has its own:&lt;/p&gt;&lt;ul data-start=&quot;180&quot; data-end=&quot;223&quot;&gt;&lt;li data-section-id=&quot;1mxb875&quot; data-start=&quot;180&quot; data-end=&quot;196&quot; style=&quot;text-align: left;&quot;&gt;✅ Power supply&lt;/li&gt;&lt;li data-section-id=&quot;1mxb875&quot; data-start=&quot;180&quot; data-end=&quot;196&quot; style=&quot;text-align: left;&quot;&gt;✅ Cooling&lt;/li&gt;&lt;li data-section-id=&quot;1gr9jbn&quot; data-start=&quot;209&quot; data-end=&quot;223&quot; style=&quot;text-align: left;&quot;&gt;✅ Networking&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;225&quot; data-end=&quot;323&quot;&gt;This ensures that if one data center fails, applications running in another zone continue to work.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#ae4132;fillColor=#fad9d5;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="610" y="2820" width="560" height="130" as="geometry" />
        </mxCell>
