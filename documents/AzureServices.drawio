        <mxCell id="y6c3Vtqz6U0YL3FhFZXc-35" value="&lt;h3&gt;. Virtualization Overview&lt;/h3&gt;&lt;ul data-spread=&quot;false&quot;&gt;&lt;li&gt;Introduction to virtualization.&lt;/li&gt;&lt;li&gt;Benefits of virtualization:&lt;/li&gt;&lt;li&gt;&lt;ul data-spread=&quot;false&quot;&gt;&lt;li&gt;Better hardware utilization.&lt;/li&gt;&lt;li&gt;Reduced infrastructure cost.&lt;/li&gt;&lt;li&gt;Faster provisioning.&lt;/li&gt;&lt;li&gt;Improved flexibility and scalability.&lt;/li&gt;&lt;li&gt;Easier backup and disaster recovery.&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;rounded=0;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="770" y="690" width="270" height="200" as="geometry" />
