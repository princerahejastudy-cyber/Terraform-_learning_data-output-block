        <mxCell id="y6c3Vtqz6U0YL3FhFZXc-73" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;VM Series&lt;/th&gt;&lt;th&gt;Purpose&lt;/th&gt;&lt;th&gt;Example Use Cases&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;B-Series (Burstable)&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Low-cost VMs for workloads with occasional CPU spikes&lt;/td&gt;&lt;td&gt;Small websites, Dev/Test, Labs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;D-Series (General Purpose)&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Balanced CPU and Memory&lt;/td&gt;&lt;td&gt;Web servers, Business applications, Databases&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;E-Series (Memory Optimized)&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;More RAM than CPU&lt;/td&gt;&lt;td&gt;SQL Server, SAP, In-memory databases&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;F-Series (Compute Optimized)&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;More CPU power&lt;/td&gt;&lt;td&gt;Gaming servers, Batch processing, Analytics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;H-Series (High Performance Computing)&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;HPC workloads&lt;/td&gt;&lt;td&gt;Scientific simulations, Engineering, AI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Lsv3-Series (Storage Optimized)&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;High disk throughput and IOPS&lt;/td&gt;&lt;td&gt;Big Data, NoSQL, Data warehousing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;M-Series&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Very large memory&lt;/td&gt;&lt;td&gt;SAP HANA, Enterprise databases&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;N-Series (GPU)&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;GPU-enabled VMs&lt;/td&gt;&lt;td&gt;AI/ML, Deep Learning, Video Rendering, Graphics&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#ae4132;fillColor=#fad9d5;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="760" y="2405" width="540" height="375" as="geometry" />
        </mxCell>
